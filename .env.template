# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000

# 許可オリジン（カンマ区切り）。本番では必ず設定する。
# 未設定時は WEBSITE_URL と localhost を許可（開発用）。
ALLOWED_ORIGINS=

# 領収書画像の保存先ディレクトリ（未設定時はリポジトリ直下 uploads/）
UPLOAD_DIR=./uploads

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=
