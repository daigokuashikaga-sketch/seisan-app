{
  "name": "seisan-app",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && bunx vite",
    "dev:desktop": "cd packages/desktop && bunx vite",
    "dev:mobile": "cd packages/mobile && bunx expo start",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "db:studio": "turbo db:studio",
    "start": "npx pm2 delete web-app 2>/dev/null || true; npx pm2 start ecosystem.config.cjs --update-env",
    "build:web": "cd packages/web && bunx vite build",
    "kill:port": "lsof -t -i :${PORT:-4200} | xargs kill -9"
  },
  "devDependencies": {
    "@tursodatabase/api": "^1.9.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "turbo": "^2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@libsql/client": "^0.17.2",
    "bcryptjs": "^3.0.3",
    "cloudflare": "^5.2.0",
    "nodemailer": "^9.0.0",
    "pm2": "^7.0.1",
    "tesseract.js": "^7.0.0"
  }
}
